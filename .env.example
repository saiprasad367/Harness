# ==============================================================================
# Adaptive Voice Agent Harness — Environment Configuration Template
# ==============================================================================

# Kaggle API Credentials (for Kyutai Moshi Free GPU Deployment)
# Get yours from https://www.kaggle.com/settings -> "Create New Token" (downloads kaggle.json)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional Hugging Face Token (if accessing gated weights)
HF_TOKEN=your_huggingface_token

# Default Moshi Server Endpoint (Local or Remote Gradio tunnel)
MOSHI_SERVER_URL=ws://localhost:8998/api/chat

